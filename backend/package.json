{
  "name": "sitara-bills-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "bun run dist/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "bun run scripts/check-db.ts",
    "db:seed:owner": "bun run scripts/seed-owner.ts"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}